# iTerm-like Ghostty configuration
auto-update = off
auto-update-channel = tip
quit-after-last-window-closed = true

# macos-icon = xray
macos-titlebar-style = tabs
window-new-tab-position = end
background-opacity = 0.93
background-blur-radius = 20

window-step-resize = true
window-padding-balance = false
window-padding-x = 14
window-padding-y = 0
window-height = 24
window-width = 83
window-position-x = 350
window-position-y = 200

# theme = dark:iTerm2 Pastel Dark Background,light:BlulocoLight
theme = dark:iTerm2 Pastel Dark Background,light:Havn Daggry
